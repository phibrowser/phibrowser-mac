    "settings.general.language.restartPrompt.message": {
      "comment": "General settings - Confirmation message explaining that the newly selected display language requires a restart",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The selected language will take effect after Phi restarts. Restart now?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Sprache wird nach einem Neustart von Phi wirksam. Jetzt neu starten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma seleccionado se aplicará después de reiniciar Phi. ¿Reiniciar ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue sélectionnée sera appliquée après le redémarrage de Phi. Redémarrer maintenant ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した言語はPhiの再起動後に反映されます。今すぐ再起動しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde taal wordt toegepast nadat Phi opnieuw is gestart. Nu herstarten?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所选语言将在 Phi 重启后生效。是否立即重启？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所選語言將在 Phi 重新啟動後生效。是否立即重新啟動？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选语言将在 Phi 重启后生效。要立即重启吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選語言會在 Phi 重新啟動後生效。要立即重新啟動嗎？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어는 Phi를 다시 시작한 뒤에 적용돼요. 지금 다시 시작할까요?"
          }
        }
      }
    },
