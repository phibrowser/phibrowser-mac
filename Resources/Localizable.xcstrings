    "settings.developer.passwordManager.approvals.explanation" : {
      "comment" : "Approvals sheet - explanation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freigaben erlauben Agenten, deine gespeicherten Zugangsdaten zu verwenden, ohne jedes Mal zu fragen. Freigaben vom Typ „Immer“ bleiben bestehen, bis du sie hier widerrufst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These grants let agents use your saved logins without asking each time. “Always” grants persist until you revoke them here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas aprobaciones permiten que los agentes usen tus inicios de sesión guardados sin pedir permiso cada vez. Las aprobaciones “Siempre” se mantienen hasta que las revoques aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces autorisations permettent aux agents d'utiliser vos identifiants enregistrés sans demander à chaque fois. Les autorisations « Toujours » restent actives jusqu'à ce que vous les révoquiez ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの許可により、エージェントは毎回確認することなく保存済みのログイン情報を使用できます。「常に許可」は、ここで取り消すまで有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 승인을 통해 에이전트가 매번 묻지 않고 저장된 로그인 정보를 사용할 수 있어요. “항상 허용” 승인은 여기에서 철회할 때까지 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze goedkeuringen kunnen agents je opgeslagen inloggegevens gebruiken zonder het elke keer te vragen. Goedkeuringen met “Altijd” blijven gelden tot je ze hier intrekt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些授权可以让智能体无需每次询问就使用你保存的登录信息。「始终」类授权会一直有效，直到你在这里撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些授權可讓 AI 代理不必每次詢問，就能使用你儲存的登入資訊。以「一律」核准的授權會持續有效，直到你在這裡撤銷為止。"
          }
        }
      }
    },
