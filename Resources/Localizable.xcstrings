    "feedback.form.privacyNotice": {
      "comment": "Feedback form - Legal disclaimer text explaining data usage, contains links to Privacy Policy and Terms of Service",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Some account and system information may be sent to Phinomenon. We will use the information you give us to help address technical issues and to improve our services, subject to our Privacy Policy and Terms of Service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分账号和系统信息可能会发送给 Phinomenon。我们会使用你提供的信息来帮助解决技术问题并改进我们的服务，具体以我们的隐私政策和服务条款为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分帳號與系統資訊可能會傳送給 Phinomenon。我們會依照隱私權政策與服務條款，使用你提供的資訊來協助解決技術問題並改善我們的服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントやシステムに関する一部の情報がPhinomenonに送信される場合があります。ご提供いただいた情報は、プライバシーポリシーおよび利用規約に従って、技術的な問題の解決とサービスの改善のために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 계정 및 시스템 정보가 Phinomenon에 전송될 수 있어요. 보내 주신 정보는 개인정보처리방침과 서비스 약관에 따라 기술적 문제를 해결하고 서비스를 개선하는 데 사용해요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines informations relatives à votre compte et à votre système peuvent être envoyées à Phinomenon. Nous utiliserons les informations que vous nous communiquez pour résoudre les problèmes techniques et améliorer nos services, conformément à nos Règles de confidentialité et à nos Conditions d'utilisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise werden einige Konto- und Systeminformationen an Phinomenon gesendet. Wir verwenden die Informationen, die du uns gibst, um technische Probleme zu beheben und unsere Dienste zu verbessern, gemäß unserer Datenschutzerklärung und unseren Nutzungsbedingungen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogelijk worden er account- en systeemgegevens naar Phinomenon gestuurd. We gebruiken de informatie die je ons geeft om technische problemen op te lossen en onze diensten te verbeteren, in overeenstemming met ons privacybeleid en onze servicevoorwaarden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se envíe cierta información de la cuenta y del sistema a Phinomenon. Usaremos la información que nos des para ayudar a resolver problemas técnicos y mejorar nuestros servicios, conforme a nuestra Política de Privacidad y a nuestros Términos del Servicio."
          }
        }
      }
    },
