    "download.safety.accountCompromise": {
      "comment": "Download safety - Warning for account-stealing malware (Chromium: IDS_DOWNLOAD_BUBBLE_SUBPAGE_SUMMARY_WARNING_COOKIE_THEFT)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file can harm your personal and social network accounts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件可能会危害你的个人账号和社交网络账号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案可能會危害你的個人帳號和社群網路帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは個人アカウントやSNSアカウントに悪影響を及ぼす可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 개인 계정과 소셜 네트워크 계정에 해를 끼칠 수 있어요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier peut compromettre vos comptes personnels et vos comptes de réseaux sociaux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann deinen privaten Konten und Konten in sozialen Netzwerken schaden"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kan schade toebrengen aan je persoonlijke accounts en socialmedia-accounts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo puede dañar tus cuentas personales y de redes sociales"
          }
        }
      }
    },
