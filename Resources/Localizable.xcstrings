    "settings.profiles.createDialog.message": {
      "comment": "Body of the create-profile dialog",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Enter a name for the new profile. Each profile has its own cookies, history, and extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入新配置文件的名称。每个配置文件都有自己的 Cookie、历史记录和扩展程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入新設定檔的名稱。每個設定檔都有自己的 Cookie、歷史記錄和擴充功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいプロファイルの名前を入力してください。各プロファイルには独自のCookie、履歴、拡張機能があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 프로필의 이름을 입력하세요. 프로필마다 별도의 쿠키, 방문 기록, 확장 프로그램이 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom pour le nouveau profil. Chaque profil possède ses propres cookies, son historique et ses extensions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen für das neue Profil ein. Jedes Profil hat eigene Cookies, einen eigenen Verlauf und eigene Erweiterungen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een naam in voor het nieuwe profiel. Elk profiel heeft zijn eigen cookies, geschiedenis en extensies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre para el perfil nuevo. Cada perfil tiene sus propias cookies, historial y extensiones."
          }
        }
      }
    },
