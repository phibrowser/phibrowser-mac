    "settings.developer.passwordManager.approvals.emptyHint": {
      "comment": "Approvals sheet - empty state hint",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Approve an agent request for 10 minutes or always and it will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准智能体请求（10分钟或始终）后，相应授权会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以「10 分鐘」或「一律」核准 AI 代理的要求後，就會顯示在這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのリクエストを「10分間」または「常に」で承認すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 요청을 10분 또는 항상으로 승인하면 여기에 표시돼요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez une demande d'agent pour 10 minutes ou pour toujours, et elle apparaîtra ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmige eine Agentenanfrage für 10 Minuten oder dauerhaft, dann erscheint sie hier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keur een agentverzoek goed voor 10 minuten of voor altijd; het verschijnt dan hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba una solicitud de un agente durante 10 minutos o siempre, y aparecerá aquí."
          }
        }
      }
    },
