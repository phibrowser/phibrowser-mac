    "settings.developer.skillInstall.single.successMessage" : {
      "comment" : "Developer settings - Skill install success body; %@ is the agent name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann jetzt den phi-browser-Skill verwenden. Starte neu konfigurierte Agenten neu; in Pi genügt /reload."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ can now use the phi-browser skill. Restart newly configured agents; in Pi, /reload is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya puede usar la habilidad phi-browser. Reinicia los agentes recién configurados; en Pi, basta con /reload."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut désormais utiliser le skill phi-browser. Redémarrez les agents nouvellement configurés ; dans Pi, /reload suffit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がphi-browserスキルを使用できるようになりました。新しく設定したエージェントは再起動してください。Piでは/reloadだけで十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이제 phi-browser 스킬을 사용할 수 있어요. 새로 구성된 에이전트는 재시작해 주세요. Pi에서는 /reload로 충분해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan nu de phi-browser-skill gebruiken. Start nieuw geconfigureerde agents opnieuw; in Pi is /reload voldoende."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 现在可以使用 phi-browser Skill 了。请重启新配置的智能体；在 Pi 中，执行 /reload 即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 現在可以使用 phi-browser Skill。請重新啟動新設定的 AI 代理；在 Pi 中，執行 /reload 即可。"
          }
        }
      }
    },
