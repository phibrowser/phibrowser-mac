    "sidebar.urlRulesEditor.emptyHint": {
      "comment": "Empty state hint in the universal URL rules editor",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Pick a target Space and enter a host like “github.com”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择目标空间，然后输入主机名，例如「github.com」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇目標空間，然後輸入主機名稱，例如「github.com」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のスペースを選び、「github.com」のようなホスト名を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 스페이스를 고르고 “github.com” 같은 호스트를 입력해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un Espace cible et saisissez un hôte tel que « github.com »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ziel-Space und gib einen Host wie „github.com“ ein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een doel-Space en voer een host in, bijvoorbeeld “github.com”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un Espacio de destino e introduce un host como “github.com”."
          }
        }
      }
