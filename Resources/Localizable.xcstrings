    "settings.general.pictureInPicture.parkAtEdgeDescription": {
      "comment": "General settings - Hint for the Park at edge auto picture-in-picture mode",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Pop out playing video, parked at the screen edge until you click it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹出正在播放的视频，并停靠在屏幕边缘，直到你点击它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓播放中的影片彈出，並停靠在螢幕邊緣，直到你按一下為止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の動画をポップアウトし、クリックするまで画面端に待機させます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 동영상을 화면 속 화면으로 띄우고, 클릭할 때까지 화면 가장자리에 둬요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la vidéo en cours de lecture en Image dans l'image, ancrée sur le bord de l'écran jusqu'à ce que vous cliquiez dessus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufendes Video als Bild-in-Bild öffnen und am Bildschirmrand parken, bis du es anklickst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start beeld in beeld voor spelende video, geparkeerd aan de schermrand tot je erop klikt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en una ventana flotante el contenido en reproducción y lo deja en el borde de la pantalla hasta que hagas clic en él"
          }
        }
      }
    },
