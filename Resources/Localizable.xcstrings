    "app.timeMachineRestore.confirmation.message": {
      "comment": "Help menu - Time Machine restore confirmation body",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Phi will quit and restore %@. The current app and selected user data will be replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 将退出并恢复 %@。当前应用和所选用户数据将被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 會結束並回復 %@。目前的 App 和所選的使用者資料將會被取代。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiを終了して%@を復元します。現在のアプリと選択したユーザーデータは置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi를 종료한 다음 %@을(를) 복원해요. 현재 앱과 선택한 사용자 데이터가 대체돼요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi va quitter et restaurer %@. L'app actuelle et les données utilisateur sélectionnées seront remplacées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi wird beendet und stellt %@ wieder her. Die aktuelle App und die ausgewählten Nutzerdaten werden ersetzt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi stopt en zet %@ terug. De huidige app en de geselecteerde gebruikersgegevens worden vervangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi se cerrará y restaurará %@. Se reemplazarán la app actual y los datos de usuario seleccionados."
          }
        }
      }
    },
