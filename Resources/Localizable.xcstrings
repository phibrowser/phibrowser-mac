    "settings.profiles.deleteConfirmation.message": {
      "comment": "Body of the delete-profile confirmation",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All cookies, history, extensions, and saved data on this profile will be permanently removed. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此个人资料中的所有 Cookie、历史记录、扩展程序和已保存的数据都将被永久移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定檔中的所有 Cookie、歷史記錄、擴充功能與已儲存的資料都將永久移除。此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルのCookie、履歴、拡張機能、保存データはすべて完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필의 모든 쿠키, 방문 기록, 확장 프로그램, 저장된 데이터가 영구적으로 제거돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les cookies, l'historique, les extensions et les données enregistrées de ce profil seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Cookies, der Verlauf, Erweiterungen und gespeicherte Daten dieses Profils werden dauerhaft entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle cookies, geschiedenis, extensies en opgeslagen gegevens van dit profiel worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cookies, el historial, las extensiones y los datos guardados de este perfil se eliminarán de forma permanente. Esto no se puede deshacer."
          }
        }
      }
    },
