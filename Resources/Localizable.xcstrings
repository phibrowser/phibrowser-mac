            "value": "Vous avez plusieurs profils, chacun gère donc ses propres paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast mehr als ein Profil, daher verwaltet jedes Profil seine eigenen Einstellungen."
          }
        },
        "nl": {
