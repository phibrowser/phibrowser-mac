    "settings.phiLink.serviceUnavailableMessage" : {
      "comment" : "IM Channels - Message shown when im-server is not connected",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale IM-Dienst ist nicht verfügbar. Prüfe, ob Phi Sentinel normal gestartet ist und der IM-Dienst läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The local IM service is unavailable. Check whether Phi Sentinel started normally and the IM service is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de mensajería local no está disponible. Comprueba si Phi Sentinel se inició correctamente y si el servicio de mensajería está en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de messagerie local est indisponible. Vérifiez que Phi Sentinel a démarré normalement et que le service de messagerie est en cours d'exécution."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのIMサービスが利用できません。Phi Sentinelが正常に起動し、IMサービスが動作しているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 IM 서비스를 사용할 수 없어요. Phi Sentinel이 정상적으로 시작됐는지, IM 서비스가 실행 중인지 확인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lokale IM-service is niet beschikbaar. Controleer of Phi Sentinel normaal is gestart en of de IM-service draait."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地 IM 服务不可用。请检查 Phi Sentinel 是否正常启动，以及 IM 服务是否正在运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機 IM 服務無法使用。請檢查 Phi Sentinel 是否正常啟動，以及 IM 服務是否正在執行。"
          }
        }
      }
    },
