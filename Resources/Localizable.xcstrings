    "settings.spaces.pinnedTabScope.appDescription": {
      "comment": "Spaces settings - description of App pinned-tab scope",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Pinned tabs are shared across all profiles and Spaces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定标签页在所有个人资料和空间之间共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選分頁會在所有設定檔和空間之間共用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定タブはすべてのプロファイルとスペースで共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 탭은 모든 프로필과 스페이스에서 공유돼요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets épinglés sont partagés entre tous les profils et tous les Espaces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Tabs werden von allen Profilen und Spaces gemeinsam genutzt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgezette tabbladen worden gedeeld door alle profielen en Spaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas fijadas se comparten entre todos los perfiles y Espacios."
          }
        }
      }
    },
