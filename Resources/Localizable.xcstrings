    "settings.spaces.changeProfileConfirmation.appScopedMessage" : {
      "comment" : "Body of the change-Space-profile confirmation with App-scoped pinned tabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster dieses Space wird mit dem neuen Profil erneut geöffnet und seine offenen Tabs werden dort neu geladen. Website-Anmeldungen werden nicht übernommen. Lesezeichen bleiben beim Space, angeheftete Tabs werden weiterhin app-weit gemeinsam genutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Space's window will be reopened with the new profile and its open tabs will be reloaded there. Site logins won't carry over. Bookmarks stay with the Space; pinned tabs remain shared across the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana de este Espacio se volverá a abrir con el perfil nuevo y sus pestañas abiertas se recargarán ahí. Los inicios de sesión de los sitios no se conservarán. Los marcadores se quedan con el Espacio; las pestañas fijadas se siguen compartiendo en toda la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre de cet Espace sera rouverte avec le nouveau profil et ses onglets ouverts y seront rechargés. Les connexions aux sites ne seront pas conservées. Les favoris restent associés à l'Espace ; les onglets épinglés restent partagés dans toute l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスペースのウインドウは新しいプロファイルで開き直され、開いているタブはそこで再読み込みされます。サイトのログイン状態は引き継がれません。ブックマークはスペースに残り、固定タブはアプリ全体で共有されたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스페이스의 윈도우가 새 프로필로 다시 열리고, 열려 있던 탭도 그곳에서 다시 불러와요. 사이트 로그인 정보는 이어지지 않아요. 북마크는 스페이스에 남고, 고정된 탭은 앱 전체에서 계속 공유돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster van deze Space wordt opnieuw geopend met het nieuwe profiel en de geopende tabbladen worden daar opnieuw geladen. Sitelogins gaan niet mee. Bladwijzers blijven bij de Space; vastgezette tabbladen blijven gedeeld binnen de app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此空间的窗口将以新的个人资料重新打开，其中已打开的标签页会在那里重新加载。网站登录状态不会保留。书签仍归此空间所有；固定标签页在整个应用内保持共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個空間的視窗會以新的設定檔重新開啟，其中開啟的分頁也會在該視窗重新載入。網站登入狀態不會一併轉移。書籤會留在這個空間；釘選分頁則維持整個應用程式共用。"
          }
        }
      }
    },
