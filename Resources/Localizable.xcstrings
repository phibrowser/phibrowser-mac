    "oobe.guestMigration.cleanupDeferred.message" : {
      "comment" : "Guest migration - Alert message for deferred deletion of the old Guest data directory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto ist bereit und deine Daten sind sicher. Phi versucht beim nächsten Start erneut, die alten Gastdaten zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your account is ready and your data is safe. Phi will try to remove the old Guest data again the next time it starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta está lista y tus datos están a salvo. Phi intentará eliminar de nuevo los datos de invitado anteriores la próxima vez que se inicie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est prêt et vos données sont en sécurité. Phi tentera à nouveau de supprimer les anciennes données du mode Invité à son prochain démarrage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントの準備が整い、データも安全に保たれています。Phiは次回起動時に、古いゲストデータの削除をもう一度試みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 준비됐고 데이터도 안전해요. Phi가 다음에 시작할 때 이전 게스트 데이터를 다시 삭제해 볼게요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account is klaar en je gegevens zijn veilig. Phi probeert de oude gastgegevens de volgende keer bij het starten opnieuw te verwijderen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账号已就绪，数据也很安全。Phi 会在下次启动时再次尝试移除旧的访客数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的帳號已就緒，資料也很安全。Phi 下次啟動時會再嘗試移除舊的訪客資料。"
          }
        }
      }
    },
