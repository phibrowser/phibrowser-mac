    "common.credentialApproval.securityHint": {
      "comment": "Credential approval - always hint",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Standing approvals can be reviewed and revoked anytime in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期批准可以随时在「设置」中查看和撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長期核准可隨時在「設定」中查看與撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常時許可は、設定でいつでも確認・取り消しできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상시 승인은 설정에서 언제든지 확인하고 철회할 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les approbations permanentes peuvent être vérifiées et révoquées à tout moment dans les Paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauerhafte Freigaben kannst du jederzeit in den Einstellungen prüfen und widerrufen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanente goedkeuringen kun je altijd bekijken en intrekken in Instellingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes revisar y revocar las aprobaciones permanentes cuando quieras en Configuración."
          }
        }
      }
    },
