    "settings.general.theme.perSpaceCustomizationHint": {
      "comment": "General settings - Hint shown when the theme color/opacity rows are locked because multiple Spaces exist",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You have more than one Space, so each Space sets its own color and opacity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有多个空间，因此每个空间各自设定自己的颜色和不透明度。"
          }
