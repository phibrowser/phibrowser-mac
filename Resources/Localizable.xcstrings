    "settings.general.developerMode.disabledHint": {
      "comment": "General settings - Hint under the developer mode toggle explaining the kill-switch behavior, the revoked approvals, and that an agent may request it back",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Turning developer mode off turns off agent access and the agent password manager, and revokes every allowed agent and credential approval. An agent that connects later can ask you to turn it back on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭开发者模式会同时关闭智能体访问和智能体密码管理器，并撤销所有已允许的智能体和凭据授权。之后连接的智能体可以请求你重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉開發者模式時，也會一併關閉 AI 代理存取和 AI 代理密碼管理員，並撤銷所有已允許的 AI 代理與憑證核准。之後連線的 AI 代理可以要求你重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デベロッパーモードをオフにすると、エージェントのアクセスとエージェント用パスワードマネージャーがオフになり、許可済みのエージェントと認証情報の承認がすべて取り消されます。あとから接続したエージェントは、オンに戻すよう求めることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 모드를 끄면 에이전트 접근과 에이전트용 비밀번호 관리자가 꺼지고, 허용된 모든 에이전트와 자격 증명 승인이 취소돼요. 이후에 연결하는 에이전트가 다시 켜 달라고 요청할 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le mode développeur désactive l'accès des agents et le gestionnaire de mots de passe des agents, et révoque tous les agents autorisés ainsi que toutes les approbations d'identifiants. Un agent qui se connecte par la suite peut vous demander de le réactiver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Entwicklermodus ausschaltest, werden der Agentenzugriff und der Passwortmanager für Agenten ausgeschaltet und alle Freigaben für Agenten und Zugangsdaten widerrufen. Ein Agent, der sich später verbindet, kann dich bitten, ihn wieder einzuschalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de ontwikkelaarsmodus uitschakelt, worden agenttoegang en de wachtwoordmanager voor agents uitgeschakeld en worden alle toegestane agents en goedkeuringen voor inloggegevens ingetrokken. Een agent die later verbinding maakt, kan je vragen om de modus weer in te schakelen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivar el modo de desarrollador se desactivan el acceso de los agentes y el gestor de contraseñas para agentes, y se revocan todos los agentes permitidos y las aprobaciones de credenciales. Un agente que se conecte más tarde puede pedirte que lo vuelvas a activar."
          }
        }
      }
    },
    "settings.general.developerMode.enabledHint": {
      "comment": "General settings - Hint under the developer mode toggle pointing at the Developer settings pane",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Agent access, permissions, and the password manager live in the Developer tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体访问、权限和密码管理器都在「开发者」标签页中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 代理存取、權限與密碼管理員都在「開發者」分頁中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのアクセス、権限、パスワードマネージャーは「開発者」タブにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 접근, 권한, 비밀번호 관리자는 개발자 탭에 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès des agents, les autorisations et le gestionnaire de mots de passe se trouvent dans l'onglet Développeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentenzugriff, Berechtigungen und den Passwortmanager findest du im Tab „Entwickler“."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenttoegang, machtigingen en de wachtwoordmanager vind je op het tabblad Ontwikkelaar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de agentes, los permisos y el administrador de contraseñas están en la pestaña Desarrollador."
          }
        }
      }
    },
