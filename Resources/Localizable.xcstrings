    "settings.spaces.pinnedTabScopeConfirmation.broadeningMessage" : {
      "comment" : "Spaces settings - confirmation body for broadening pinned-tab scope",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeheftete Tabs aus den bestehenden Zielen werden zusammengeführt. Unveränderte Kopien werden vereint, unterschiedliche Versionen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned tabs from the existing destinations will be merged. Unchanged copies will be combined, while different versions will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fusionarán las pestañas fijadas de los destinos actuales. Las copias sin cambios se combinarán y se conservarán las versiones distintas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les onglets épinglés des destinations existantes seront fusionnés. Les copies identiques seront regroupées, tandis que les versions différentes seront conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の保存先にある固定タブは統合されます。変更のないものはまとめられ、内容が異なるものはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 대상의 고정된 탭이 병합돼요. 동일한 사본은 하나로 합쳐지고, 서로 다른 버전은 모두 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgezette tabbladen van de bestaande bestemmingen worden samengevoegd. Ongewijzigde kopieën worden gecombineerd, verschillende versies blijven bewaard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现有目标位置中的固定标签页将会合并。未改动的副本会合并为一份，不同的版本会分别保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現有目的地的釘選分頁將會合併。未變更的副本會合併在一起，不同的版本則會保留。"
          }
        }
      }
    },
