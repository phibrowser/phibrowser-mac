    "settings.general.restoreLastSession.disabledHint": {
      "comment": "General settings - Hint shown when restore-last-session is off, noting session cookies may be cleared when a window closes",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Phi starts with a new window. Closing a window may sign you out of some sites."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 启动时打开新窗口。关闭窗口可能会让你在部分网站上退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 會以新視窗啟動。關閉視窗可能會讓你從某些網站登出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiは新しいウインドウで起動します。ウインドウを閉じると、一部のサイトからログアウトされる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi가 새 윈도우로 시작해요. 윈도우를 닫으면 일부 사이트에서 로그아웃될 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi démarre avec une nouvelle fenêtre. La fermeture d'une fenêtre peut vous déconnecter de certains sites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi startet mit einem neuen Fenster. Wenn du ein Fenster schließt, wirst du auf manchen Websites möglicherweise abgemeldet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi start met een nieuw venster. Als je een venster sluit, word je bij sommige sites mogelijk uitgelogd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi se abre con una ventana nueva. Al cerrar una ventana, es posible que se cierre tu sesión en algunos sitios."
          }
        }
      }
    },
    "settings.general.restoreLastSession.enabledHint": {
      "comment": "General settings - Hint shown when restore-last-session is on",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reopen your windows and tabs the next time you open Phi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Phi 时重新打开你的窗口和标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次開啟 Phi 時，重新開啟你的視窗和分頁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にPhiを起動したときに、ウインドウとタブを再度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 Phi를 열 때 윈도우와 탭을 다시 열어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre vos fenêtres et vos onglets à la prochaine ouverture de Phi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fenster und Tabs werden beim nächsten Start von Phi wieder geöffnet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open je vensters en tabbladen opnieuw wanneer je Phi de volgende keer start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volverán a abrir tus ventanas y pestañas la próxima vez que abras Phi."
          }
        }
      }
    },
