    "settings.developer.passwordManager.approvals.grantedDateTooltip": {
      "comment": "Approvals sheet - grant date tooltip",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Granted %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权于 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於 %@ 授予"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可日: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 허용됨"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordé le %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilt am %@"
          }
        },
