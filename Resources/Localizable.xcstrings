    "settings.developer.skillInstall.overwriteConfirmation.message": {
      "comment": "Developer settings - Skill overwrite prompt body",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%@” already exists and isn’t a link created by Phi Browser. Replace it with a link to this app’s bundled skill?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已存在，且不是由 Phi Browser 创建的链接。要将其替换为指向本应用内置 Skill 的链接吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已存在，且不是 Phi Browser 建立的連結。要將它取代為指向此 App 內建 Skill 的連結嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでに存在し、Phi Browserが作成したリンクではありません。このアプリに同梱されているスキルへのリンクに置き換えますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 이미 존재하지만 Phi Browser가 만든 링크가 아니에요. 이 앱에 포함된 스킬로 연결되는 링크로 교체할까요?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » existe déjà et n'est pas un lien créé par Phi Browser. Le remplacer par un lien vers le skill fourni avec cette app ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ existiert bereits und ist kein von Phi Browser erstellter Link. Durch einen Link auf den in dieser App enthaltenen Skill ersetzen?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” bestaat al en is geen koppeling die door Phi Browser is aangemaakt. Wil je deze vervangen door een koppeling naar de meegeleverde skill van deze app?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya existe y no es un enlace creado por Phi Browser. ¿Reemplazarlo por un enlace a la habilidad incluida en esta app?"
          }
        }
      }
    },
