    "settings.ai.phiSentinel.description": {
      "comment": "AI settings - Description explaining what Phi Sentinel does",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Phi Sentinel is a lightweight background helper that allows Phi to complete scheduled AI tasks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel 是一个轻量的后台辅助程序，让 Phi 能够完成定时 AI 任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel 是輕量的背景輔助程式，讓 Phi 能完成排程的 AI 任務"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinelは、スケジュールされたAIタスクをPhiが完了できるようにする軽量なバックグラウンドヘルパーです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel은 Phi가 예약된 AI 작업을 완료할 수 있게 해주는 가벼운 백그라운드 도우미예요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel est un utilitaire d'arrière-plan léger qui permet à Phi d'exécuter des tâches IA planifiées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel ist ein schlanker Hintergrunddienst, mit dem Phi geplante KI-Aufgaben erledigen kann"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel is een lichte achtergrondhelper waarmee Phi geplande AI-taken kan uitvoeren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi Sentinel es un auxiliar ligero en segundo plano que permite a Phi completar tareas de IA programadas"
          }
        }
      }
    },
