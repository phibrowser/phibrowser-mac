    "oobe.guestMigration.recovery.loginMessage": {
      "comment": "Guest migration recovery - Guidance shown when the original target account must sign in again",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sign in to the account you previously selected to finish moving your Guest data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录你之前选择的账号，以完成访客数据的迁移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請登入你先前選擇的帳號，以完成訪客資料的搬移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストデータの移行を完了するには、前に選択したアカウントでログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 데이터 이동을 완료하려면 앞서 선택한 계정으로 로그인해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au compte que vous aviez sélectionné pour terminer le transfert de vos données du mode Invité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei dem Konto an, das du zuvor ausgewählt hast, um das Verschieben deiner Gastdaten abzuschließen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in op het account dat je eerder hebt gekozen om het verplaatsen van je gastgegevens af te ronden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la cuenta que seleccionaste antes para terminar de mover tus datos de invitado."
          }
        }
      }
    },
