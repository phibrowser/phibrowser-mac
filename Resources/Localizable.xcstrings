    "settings.developer.passwordManager.extensionInstallPrompt.message": {
      "comment": "Phi & AI settings - Alert message explaining the suggested Bitwarden extension install",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The Bitwarden browser extension autofills your vault logins on web pages. Phi can install it from the Chrome Web Store now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 浏览器扩展程序可以在网页上自动填充你密码库中的登录信息。Phi 现在可以从 Chrome 网上应用店安装它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 瀏覽器擴充功能會在網頁上自動填入你密碼庫中的登入資訊。Phi 現在可以從 Chrome 線上應用程式商店安裝它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwardenのブラウザ拡張機能は、ウェブページで保管庫のログイン情報を自動入力します。今すぐPhiがChromeウェブストアからインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 브라우저 확장 프로그램은 웹 페이지에서 보관함의 로그인 정보를 자동으로 입력해요. 지금 Phi가 Chrome 웹 스토어에서 설치할 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension de navigateur Bitwarden remplit automatiquement les identifiants de votre coffre sur les pages web. Phi peut l'installer dès maintenant depuis le Chrome Web Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bitwarden-Browsererweiterung füllt deine im Tresor gespeicherten Zugangsdaten auf Webseiten automatisch aus. Phi kann sie jetzt aus dem Chrome Web Store installieren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Bitwarden-browserextensie vult je kluislogins automatisch in op webpagina’s. Phi kan de extensie nu installeren vanuit de Chrome Web Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión de Bitwarden para el navegador rellena automáticamente los inicios de sesión de tu caja fuerte en las páginas web. Phi puede instalarla ahora desde Chrome Web Store."
          }
        }
      }
    },
