    "settings.account.reauthentication.tooltip": {
      "comment": "Account settings - Tooltip explaining why reauthentication is needed",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Please reauthenticate to restore account features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新验证身份以恢复账号功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新驗證身分以恢復帳號功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント機能を復元するには、再認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 기능을 복구하려면 다시 인증해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez-vous à nouveau pour rétablir les fonctionnalités du compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiziere dich erneut, um die Kontofunktionen wiederherzustellen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer je opnieuw om de accountfuncties te herstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a autenticarte para restaurar las funciones de la cuenta."
          }
        }
      }
    },
