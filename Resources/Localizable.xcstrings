    "app.uninstall.confirmation.message" : {
      "comment" : "Phi uninstall - Critical confirmation message describing the channel-scoped data that will be permanently removed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi und Phi Sentinel werden beendet. Browserdaten, Unterhaltungen, KI-Erinnerungen, Dienstdaten und lokale KI-Modelle dieser Phi-Version werden dauerhaft gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Phi and Phi Sentinel will quit. Browsing data, conversations, AI memory, service data, and local AI models for this version of Phi will be permanently deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi y Phi Sentinel se cerrarán. Los datos de navegación, las conversaciones, la memoria de IA, los datos de servicio y los modelos de IA locales de esta versión de Phi se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi et Phi Sentinel vont quitter. Les données de navigation, les conversations, la mémoire de l'IA, les données de service et les modèles d'IA locaux de cette version de Phi seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhiとPhi Sentinelが終了します。このバージョンのPhiの閲覧データ、会話、AIメモリ、サービスデータ、ローカルAIモデルは完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi와 Phi Sentinel이 종료돼요. 이 버전의 Phi에 있는 브라우징 데이터, 대화, AI 메모리, 서비스 데이터, 로컬 AI 모델이 영구적으로 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi en Phi Sentinel worden gestopt. Browsegegevens, gesprekken, AI-geheugen, servicegegevens en lokale AI-modellen van deze versie van Phi worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi 和 Phi Sentinel 将会退出。此版本 Phi 的浏览数据、对话、AI 记忆、服务数据和本地 AI 模型都将被永久删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi 和 Phi Sentinel 將會結束。此版本 Phi 的瀏覽資料、對話、AI 記憶、服務資料與本機 AI 模型都會被永久刪除。此操作無法復原。"
          }
        }
      }
    },
