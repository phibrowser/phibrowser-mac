    "accountDeletion.verification.resendCooldownButton": {
      "comment": "Account deletion - Resend button label while the one-minute cooldown runs. %d is the seconds remaining",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Resend Code (%ds)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新发送验证码（%ds）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新傳送驗證碼（%d 秒）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを再送信 (%d秒)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 다시 보내기 (%d초)"
          }
        },
        "fr": {
