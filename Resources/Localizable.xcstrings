          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 데이터 정리가 끝나지 않았어요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage des données du mode Invité est incomplet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
