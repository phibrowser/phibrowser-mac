    "settings.general.pictureInPicture.offDescription": {
      "comment": "General settings - Hint for the Off auto picture-in-picture mode",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Never pop out automatically; manual picture-in-picture still works"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不自动弹出；手动画中画仍然可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永不自動彈出；手動子母畫面仍可使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ではポップアウトしません。手動のピクチャインピクチャは引き続き使えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 화면 속 화면을 띄우지 않아요. 수동 화면 속 화면은 계속 사용할 수 있어요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne passe jamais automatiquement en Image dans l'image ; le mode Image dans l'image manuel reste disponible"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie automatisch als Bild-in-Bild öffnen; manuelles Bild-in-Bild funktioniert weiterhin"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nooit automatisch beeld in beeld starten; handmatig beeld in beeld werkt nog steeds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se abre la ventana flotante automáticamente; la imagen en imagen manual sigue funcionando"
          }
        }
      }
    },
