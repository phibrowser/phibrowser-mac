    "spaces.closeIncognitoConfirmation.title" : {
      "comment" : "Title of the confirmation shown when a close would tear down an Incognito Space",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird auch dieser Inkognito-Space geschlossen. Bist du sicher?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will also close this Incognito Space, are you sure?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto también cerrará este Espacio de incógnito. ¿Seguro que quieres continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela fermera également cet Espace de navigation privée. Voulez-vous vraiment continuer ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作を行うと、このシークレットスペースも閉じられます。よろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시크릿 스페이스도 함께 닫혀요. 계속할까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt ook deze Incognito-Space gesloten. Weet je het zeker?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这也会关闭此无痕空间，确定吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這也會關閉這個無痕空間，確定要繼續嗎？"
          }
        }
      }
    },
