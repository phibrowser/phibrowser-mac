    "spaces.importProgress.changeProfileBlocked.message" : {
      "comment" : "Body shown when a Space action is blocked by an in-progress import",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Import fügt diesem Space noch Lesezeichen hinzu. Warte, bis er abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An import is still adding bookmarks to this Space. Wait for it to finish, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una importación aún está agregando marcadores a este Espacio. Espera a que termine y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une importation ajoute encore des favoris à cet Espace. Attendez qu'elle se termine, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートがまだこのスペースにブックマークを追加しています。完了を待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기가 아직 이 스페이스에 북마크를 추가하고 있어요. 완료될 때까지 기다렸다가 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden door een import nog bladwijzers aan deze Space toegevoegd. Wacht tot de import klaar is en probeer het opnieuw."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入操作仍在向此空间添加书签。请等待其完成后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入作業仍在將書籤加入此空間。請等它完成後再試一次。"
          }
        }
      }
    },
