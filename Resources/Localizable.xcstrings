    "app.importBrowserData.unavailableInIncognito.message" : {
      "comment" : "Import browser data - Alert body explaining import is unavailable off-the-record",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browserdaten können nicht in Inkognito importiert werden. Wechsle zu einem normalen Space oder Fenster und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Browser data can't be imported into Incognito. Switch to a regular Space or window, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del navegador no se pueden importar en Incógnito. Cambia a un Espacio o a una ventana normal y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du navigateur ne peuvent pas être importées en navigation privée. Passez à un Espace normal ou à une fenêtre normale, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットモードにはブラウザデータをインポートできません。通常のスペースまたはウインドウに切り替えてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시크릿 모드로는 브라우저 데이터를 가져올 수 없어요. 일반 스페이스나 윈도우로 전환한 후 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browsergegevens kunnen niet in incognito worden geïmporteerd. Schakel over naar een gewone Space of een gewoon venster en probeer het opnieuw."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器数据无法导入无痕模式。请切换到常规空间或窗口后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽器資料無法匯入無痕模式。請切換到一般空間或視窗，然後再試一次。"
          }
        }
      }
    },
