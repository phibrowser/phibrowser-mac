    "agent.handoffPrompt.message": {
      "comment": "Agent handoff prompt - default body",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The agent handed control back to you to finish a step — for example, signing in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体已把控制权交还给你，以便你完成某个步骤，例如登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 代理已將控制權交還給你，以完成某個步驟，例如登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインなど、一部の手順を完了する必要があるため、エージェントが操作を戻しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 로그인처럼 사용자가 직접 마무리해야 하는 단계가 있어 제어권을 넘겼어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent vous a rendu la main pour terminer une étape, par exemple une connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent hat die Steuerung an dich zurückgegeben, damit du einen Schritt abschließt, zum Beispiel eine Anmeldung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De agent heeft de besturing aan jou teruggegeven om een stap af te ronden, bijvoorbeeld inloggen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente te devolvió el control para que completes un paso, por ejemplo, iniciar sesión."
          }
        }
      }
    },
