    "toolbar.tabGroupChip.interactionTooltip": {
      "comment": "Tab Groups - tooltip for horizontal-strip group chip interactions",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Click the title for overview. Click the arrow to expand or collapse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标题查看概览。点按箭头展开或折叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下標題可查看總覽。按一下箭頭可展開或收合。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルをクリックすると概要が表示されます。矢印をクリックすると展開・折りたたみを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목을 클릭하면 개요가 열려요. 화살표를 클릭하면 펼치거나 접을 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le titre pour afficher la vue d'ensemble. Cliquez sur la flèche pour développer ou réduire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den Titel für die Übersicht. Klicke auf den Pfeil zum Ein- oder Ausklappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de titel voor het overzicht. Klik op de pijl om uit te klappen of in te klappen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el título para ver la vista general. Haz clic en la flecha para expandir o contraer."
          }
        }
      }
    },
