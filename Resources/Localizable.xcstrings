    "common.credentialApproval.valueRequest.loginExplanation" : {
      "comment" : "Credential approval - run body",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi gibt den gespeicherten Wert an den Agenten weiter, damit der ausgeführte Befehl ihn verwenden kann. Phi kann nicht verhindern, dass der Agent den Wert behält. Gib ihn nur für Agenten und Websites frei, denen du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Phi releases the saved value to the agent so the command it runs can use it. Phi can’t stop the agent from keeping the value — only approve for agents and sites you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi entrega el valor guardado al agente para que el comando que ejecuta pueda usarlo. Phi no puede impedir que el agente conserve ese valor: aprueba solo agentes y sitios en los que confíes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi transmet la valeur enregistrée à l'agent afin que la commande qu'il exécute puisse l'utiliser. Phi ne peut pas empêcher l'agent de conserver cette valeur : n'accordez votre approbation qu'aux agents et aux sites en lesquels vous avez confiance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiは保存された値をエージェントに渡し、エージェントが実行するコマンドで使えるようにします。エージェントがその値を保持することをPhiは防げません。信頼できるエージェントとサイトにのみ許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi가 저장된 값을 에이전트에 전달해 에이전트가 실행하는 명령에서 사용할 수 있게 해요. 에이전트가 그 값을 계속 보관하는 것은 Phi가 막을 수 없으니, 신뢰하는 에이전트와 사이트에만 승인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi geeft de opgeslagen waarde door aan de agent, zodat het commando dat de agent uitvoert die kan gebruiken. Phi kan niet voorkomen dat de agent de waarde bewaart. Keur dit alleen goed voor agents en sites die je vertrouwt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi 会把保存的值交给智能体，供它运行的命令使用。Phi 无法阻止智能体留存该值，请只为你信任的智能体和网站授予批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi 會將已儲存的值提供給 AI 代理，讓它執行的指令可以使用。Phi 無法阻止 AI 代理保留這個值，請只對你信任的 AI 代理和網站授予核准。"
          }
        }
      }
    },
    "common.credentialApproval.valueRequest.sensitiveItemExplanation" : {
      "comment" : "Credential approval - reveal body",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gespeicherte Element, also ein Passwort, eine Notiz, eine Karte, eine Identität oder ein Schlüssel, wird an den Agenten weitergegeben, der es in seinem Kontext speichern kann. Gib es nur für Agenten und Elemente frei, denen du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The saved item — a password, note, card, identity, or key — is shared with the agent, which may record it in its context. Only approve for agents and items you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento guardado (una contraseña, una nota, una tarjeta, una identidad o una clave) se comparte con el agente, que puede registrarlo en su contexto. Apruébalo solo para agentes y elementos en los que confíes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'élément enregistré (mot de passe, note, carte, identité ou clé) est divulgué à l'agent, qui peut le conserver dans son contexte. N'accordez votre approbation qu'aux agents et aux éléments en lesquels vous avez confiance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された項目（パスワード、メモ、カード、ID情報、キー）がエージェントに共有され、エージェントのコンテキストに記録される可能性があります。信頼できるエージェントと項目に対してのみ許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 항목(비밀번호, 메모, 카드, 신원 정보, 키)이 에이전트에 공유되고, 에이전트가 이를 컨텍스트에 기록할 수도 있어요. 신뢰하는 에이전트와 항목에만 승인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het opgeslagen item (een wachtwoord, notitie, kaart, identiteit of sleutel) wordt gedeeld met de agent, die het in zijn context kan vastleggen. Keur dit alleen goed voor agents en items die je vertrouwt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存的项目（密码、备注、卡片、身份或密钥）会共享给智能体，智能体可能会将其记录到自己的上下文中。请只为你信任的智能体和项目授予批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的項目（密碼、備註、卡片、身分或金鑰）會提供給 AI 代理，代理可能會將它記錄在自己的上下文中。請只對你信任的 AI 代理和項目授予核准。"
          }
        }
      }
    },
