    "oobe.guestMode.credentialClearFailure.message": {
      "comment": "Guest mode - Alert message asking the user to retry after credential cleanup failed",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Phi couldn’t securely clear the previous session. Try again before continuing as Guest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 未能安全清除上一个会话。请重试后再以访客身份继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 無法安全地清除先前的工作階段。請再試一次，然後再以訪客身分繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiは前のセッションを安全に消去できませんでした。ゲストとして続ける前に、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi가 이전 세션을 안전하게 지우지 못했어요. 게스트로 계속하기 전에 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi n'a pas pu effacer de manière sécurisée la session précédente. Réessayez avant de continuer en tant qu'invité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi konnte die vorherige Sitzung nicht sicher löschen. Versuche es erneut, bevor du als Gast fortfährst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi kon de vorige sessie niet veilig wissen. Probeer het opnieuw voordat je als gast verdergaat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi no pudo borrar de forma segura la sesión anterior. Vuelve a intentarlo antes de continuar como invitado."
          }
        }
      }
    },
