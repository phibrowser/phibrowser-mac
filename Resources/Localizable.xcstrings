    "localData.compatibilityAlert.newerVersionMessage" : {
      "comment" : "Local store compatibility alert - body when a newer app is required to read local data",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version von Phi kann keine lokalen Browserdaten öffnen, die von einer neueren Version aktualisiert wurden. Installiere die neueste Phi-Version und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This version of Phi cannot open local browser data that was updated by a newer version. Install the latest Phi version and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de Phi no puede abrir datos locales del navegador que se actualizaron con una versión más reciente. Instala la última versión de Phi e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de Phi ne peut pas ouvrir des données de navigateur locales mises à jour par une version plus récente. Installez la dernière version de Phi et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンのPhiでは、新しいバージョンで更新されたローカルのブラウザデータを開けません。最新バージョンのPhiをインストールして、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 Phi는 더 새로운 버전이 업데이트한 로컬 브라우저 데이터를 열 수 없어요. 최신 Phi 버전을 설치하고 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie van Phi kan geen lokale browsergegevens openen die door een nieuwere versie zijn bijgewerkt. Installeer de nieuwste versie van Phi en probeer het opnieuw."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Phi 无法打开由更新版本更新过的本地浏览器数据。请安装最新版 Phi 后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個版本的 Phi 無法開啟由較新版本更新過的本機瀏覽器資料。請安裝最新版的 Phi 後再試一次。"
          }
        }
      }
    },
