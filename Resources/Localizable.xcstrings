    "settings.spaces.pinnedTabScopeConfirmation.narrowingMessage" : {
      "comment" : "Spaces settings - confirmation body for narrowing pinned-tab scope",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine aktuellen angehefteten Tabs werden in jedes bestehende Ziel kopiert. Die Kopien können danach unabhängig voneinander geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your current pinned tabs will be copied into each existing destination. The copies can then be changed independently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pestañas fijadas actuales se copiarán en cada destino existente. Después, las copias se pueden modificar de forma independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos onglets épinglés actuels seront copiés dans chaque destination existante. Les copies pourront ensuite être modifiées indépendamment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の固定タブが、既存の各コピー先に複製されます。複製後は、それぞれ個別に変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 고정된 탭이 기존 대상마다 복사돼요. 이후에는 사본을 각각 따로 변경할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je huidige vastgezette tabbladen worden naar elke bestaande bestemming gekopieerd. De kopieën kun je daarna los van elkaar wijzigen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你当前的固定标签页会被复制到每个现有的目标位置。之后可以分别独立更改这些副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你目前的釘選分頁會複製到每個現有的目的地，之後這些副本可以各自獨立修改。"
          }
        }
      }
    },
