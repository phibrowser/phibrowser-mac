    "accountDeletion.verification.rateLimitError" : {
      "comment" : "Account deletion - Error when the deletion service rate limit is hit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
