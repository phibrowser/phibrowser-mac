    "settings.general.profile.multipleProfilesHint": {
      "comment": "General settings - Hint shown in place of the inline profile settings because multiple profiles exist",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You have more than one profile, so each profile manages its own settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有多个个人资料，因此每个个人资料各自管理自己的设置。"
