    "settings.general.pictureInPicture.normalDescription": {
      "comment": "General settings - Hint for the Normal auto picture-in-picture mode",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Pop out playing video when you switch tabs or apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换标签页或应用时弹出正在播放的视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換分頁或 App 時，讓播放中的影片彈出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブやアプリを切り替えたときに、再生中の動画をポップアウトします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이나 앱을 전환하면 재생 중인 동영상을 화면 속 화면으로 띄워요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la vidéo en cours de lecture en Image dans l'image lorsque vous changez d'onglet ou d'app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufendes Video als Bild-in-Bild öffnen, wenn du Tabs oder Apps wechselst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start beeld in beeld voor spelende video als je van tabblad of app wisselt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en una ventana flotante el contenido en reproducción cuando cambies de pestaña o de app"
          }
        }
      }
    },
