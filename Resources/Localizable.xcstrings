    "oobe.guestMigration.targetRecovery.message": {
      "comment": "Guest migration - Alert message explaining why the same account migration must be retried",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Some data has already been moved to this account. Phi must retry with the same account before Guest data can be used again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分数据已迁移到此账号。Phi 必须用同一个账号重试，之后才能再次使用访客数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資料已經搬移到這個帳號。Phi 必須用同一個帳號重試，才能再次使用訪客資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のデータはすでにこのアカウントに移行されています。ゲストデータをもう一度使えるようにするには、Phiが同じアカウントで移行をやり直す必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 데이터는 이미 이 계정으로 이동됐어요. 게스트 데이터를 다시 사용하려면 Phi가 같은 계정으로 다시 시도해야 해요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données ont déjà été transférées vers ce compte. Phi doit réessayer avec le même compte avant que les données du mode Invité puissent être réutilisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Daten wurden bereits in dieses Konto verschoben. Phi muss es mit demselben Konto erneut versuchen, bevor die Gastdaten wieder verwendet werden können."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn al gegevens naar dit account verplaatst. Phi moet het opnieuw proberen met hetzelfde account voordat je de gastgegevens weer kunt gebruiken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos datos ya se movieron a esta cuenta. Phi debe volver a intentarlo con la misma cuenta para poder usar de nuevo los datos de invitado."
          }
        }
      }
    },
