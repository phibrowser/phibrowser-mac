    "settings.developer.agentControl.blockedAgents.description": {
      "comment": "Developer settings - Explanation for the blocked agent list",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Turned away without asking you, from a “Never ask again” or “For 30 min” denial. Unblocking one makes it ask again next time it connects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些智能体因为「不再询问」或「30 分钟内」的拒绝而被直接挡回，不会再询问你。解除对某个智能体的阻止后，它下次连接时会重新询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為「不再詢問」或「30 分鐘內」的拒絕，未經詢問就被擋下。解除封鎖其中一個後，它下次連線時會再次詢問你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今後確認しない」または「30分間」で拒否したため、確認なしで拒否されています。ブロックを解除すると、次に接続したときにもう一度確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“다시 묻지 않기” 또는 “30분 동안” 거부에 따라 확인 없이 차단된 에이전트예요. 차단을 해제하면 다음에 연결할 때 다시 물어봐요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusés sans vous demander votre avis, à la suite d'un refus « Ne plus demander » ou « Pendant 30 min ». Si vous en débloquez un, il vous redemandera lors de sa prochaine connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Nachfrage abgewiesen, wegen einer Ablehnung mit „Nie wieder fragen“ oder „Für 30 Min.“. Wenn du einen Agenten entsperrst, fragt er beim nächsten Verbinden wieder nach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgewezen zonder het je te vragen, op basis van een weigering met “Nooit meer vragen” of “Voor 30 min”. Als je er een deblokkeert, wordt er bij de volgende verbinding opnieuw om goedkeuring gevraagd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se les rechaza sin preguntarte, por una denegación de «No volver a preguntar» o «Durante 30 min». Si desbloqueas uno, volverá a preguntarte la próxima vez que se conecte."
          }
        }
      }
    },
