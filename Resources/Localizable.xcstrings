    "agentControl.connectionApproval.enablesFeatureNote": {
      "comment": "CDP consent - body of the banner shown when allowing will also enable the developer mode and agent control settings",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Allowing also turns on Developer mode and “Allow agents to control Phi (CDP)” in Settings; you can switch them back off there at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，还会同时开启「设置」中的开发者模式和「允许智能体控制 Phi（CDP）」；你随时可以在那里重新关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許後，也會在「設定」中開啟「開發者模式」和「允許 AI 代理控制 Phi（CDP）」；你隨時可以在那裡關閉它們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、設定の「デベロッパーモード」と「エージェントによるPhiの操作を許可（CDP）」もオンになります。どちらも設定でいつでもオフに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 설정의 개발자 모드와 “에이전트가 Phi를 제어하도록 허용(CDP)”도 함께 켜져요. 설정에서 언제든지 다시 끌 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser active aussi le mode développeur et l'option « Autoriser les agents à contrôler Phi (CDP) » dans les Paramètres ; vous pouvez les désactiver à tout moment à cet endroit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du erlaubst, werden in den Einstellungen auch der Entwicklermodus und „Agenten erlauben, Phi zu steuern (CDP)“ aktiviert; dort kannst du beides jederzeit wieder ausschalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je dit toestaat, worden ook de ontwikkelaarsmodus en “Agents toestaan Phi te besturen (CDP)” in Instellingen ingeschakeld; je kunt ze daar op elk moment weer uitschakelen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al permitirlo también se activan el modo de desarrollador y «Permitir que los agentes controlen Phi (CDP)» en Configuración; puedes volver a desactivarlos ahí en cualquier momento."
          }
        }
      }
    },
