    "settings.phiLink.officialBot.qrCode.scanHint": {
      "comment": "Phi Link - Official bot QR hint",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Scan the QR code with your phone camera or click on the button below to add Phi Link bot to your Telegram"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机扫描二维码，或点按下方按钮，将 Phi Link 机器人添加到你的 Telegram"
          }
        },
        "zh-Hant": {
