    "app.deleteSpaceConfirmation.message": {
      "comment": "Body of the delete-Space confirmation",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bookmarks belonging to this Space will also be removed. This action cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于此空间的书签也将被移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於此空間的書籤也會一併移除。此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスペースに属するブックマークも削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스페이스에 속한 북마크도 함께 제거돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris appartenant à cet Espace seront également supprimés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Space gehörende Lesezeichen werden ebenfalls entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bladwijzers die bij deze Space horen, worden ook verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores que pertenecen a este Espacio también se eliminarán. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "app.deleteSpaceConfirmation.spaceScopedMessage": {
      "comment": "Body of the delete-Space confirmation with Space-scoped pinned tabs",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bookmarks and pinned tabs belonging to this Space will also be removed. This action cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于此空间的书签和固定标签页也将被移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於此空間的書籤與釘選分頁也會一併移除。此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスペースに属するブックマークと固定タブも削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스페이스에 속한 북마크와 고정된 탭도 함께 제거돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris et les onglets épinglés appartenant à cet Espace seront également supprimés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Space gehörende Lesezeichen und angeheftete Tabs werden ebenfalls entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bladwijzers en vastgezette tabbladen die bij deze Space horen, worden ook verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
