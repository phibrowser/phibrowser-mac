    "common.credentialApproval.autofillRequest.explanation" : {
      "comment" : "Credential approval - fill body",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi trägt die gespeicherten Anmeldedaten selbst in die Seite ein. Der Agent löst das Ausfüllen aus, erhält aber nie den Benutzernamen oder das Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Phi fills the saved login into the page itself. The agent triggers the fill but never receives the username or password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi rellena el inicio de sesión guardado en la propia página. El agente activa el relleno, pero nunca recibe el nombre de usuario ni la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi remplit lui-même la page avec l'identifiant enregistré. L'agent déclenche le remplissage mais ne reçoit jamais le nom d'utilisateur ni le mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiが保存済みのログイン情報をページに直接入力します。エージェントは入力のきっかけを作るだけで、ユーザー名やパスワードを受け取ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi가 저장된 로그인 정보를 페이지에 직접 입력해요. 에이전트는 입력을 실행시킬 뿐, 사용자 이름이나 비밀번호를 받지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi vult de opgeslagen inloggegevens zelf in op de pagina. De agent start het invullen, maar krijgt de gebruikersnaam of het wachtwoord nooit te zien."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi 会直接把保存的登录信息填入页面。智能体只触发填充，不会拿到用户名或密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi 會自行將已儲存的登入資訊填入頁面。AI 代理只會觸發填入動作，永遠不會取得使用者名稱或密碼。"
          }
        }
      }
    },
