        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiのセッションの有効期限が切れました。もう一度ログインしてから、Phi Linkをやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 세션이 만료됐어요. 다시 로그인한 뒤 Phi Link를 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Phi a expiré. Veuillez vous reconnecter, puis réessayer Phi Link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Phi-Sitzung ist abgelaufen. Bitte melde dich erneut an und versuche Phi Link dann noch einmal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Phi-sessie is verlopen. Log opnieuw in en probeer Phi Link daarna nogmaals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de Phi caducó. Inicia sesión de nuevo y vuelve a intentar Phi Link."
          }
        }
      }
    },
