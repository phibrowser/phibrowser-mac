    "common.credentialUnlock.message": {
      "comment": "Credential unlock - body",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” needs a credential for %2$@, but your vault is locked. Enter your master password to unlock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」需要用于 %2$@ 的凭据，但你的保险库已锁定。请输入主密码解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」需要 %2$@ 的憑證，但你的密碼庫已鎖定。請輸入主密碼來解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」が%2$@の認証情報を必要としていますが、保管庫がロックされています。マスターパスワードを入力してロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”에서 %2$@의 자격 증명이 필요하지만 보관함이 잠겨 있어요. 마스터 비밀번호를 입력해 잠금을 해제해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » a besoin d'un identifiant pour %2$@, mais votre coffre est verrouillé. Saisissez votre mot de passe maître pour le déverrouiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ benötigt Zugangsdaten für %2$@, aber dein Tresor ist gesperrt. Gib dein Master-Passwort ein, um ihn zu entsperren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” heeft inloggegevens nodig voor %2$@, maar je kluis is vergrendeld. Voer je hoofdwachtwoord in om te ontgrendelen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” necesita una credencial para %2$@, pero tu caja fuerte está bloqueada. Introduce tu contraseña maestra para desbloquearla."
          }
        }
      }
    },
