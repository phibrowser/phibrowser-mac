    "settings.developer.passwordManager.bitwarden.toggleDescription" : {
      "comment" : "Phi & AI settings - Bitwarden toggle explanation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldedaten für Phi und Agent-Anfragen, verwahrt von einem separaten Hilfsprogramm. Passwörter gelangen nie in den Browserprozess."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Logins for Phi and agent requests, held by a separate helper — passwords never touch the browser process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicios de sesión para Phi y para las solicitudes de los agentes, guardados por un auxiliar independiente: las contraseñas nunca pasan por el proceso del navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiants pour Phi et pour les requêtes des agents, conservés par un utilitaire distinct : les mots de passe ne transitent jamais par le processus du navigateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiとエージェントのリクエストで使うログイン情報を、独立したヘルパーが保持します。パスワードがブラウザプロセスに渡ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi와 에이전트 요청에 쓰이는 로그인 정보를 별도 도우미가 보관해요. 비밀번호는 브라우저 프로세스에 전달되지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggegevens voor Phi en agentverzoeken, bewaard door een aparte helper. Wachtwoorden komen nooit in het browserproces."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 Phi 和智能体请求提供登录信息，由独立的辅助程序保管，密码不会进入浏览器进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供 Phi 和 AI 代理要求使用的登入資訊，由獨立的輔助程式保管，密碼永遠不會進入瀏覽器程序。"
          }
        }
      }
    },
