    "settings.developer.passwordManager.approvals.enableAllConfirmation.message" : {
      "comment" : "Approvals sheet - all-access confirm message",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Agent kann dann alle Zugangsdaten in deinem Tresor verwenden, ohne dich vorher zu fragen. Ein getäuschter Agent könnte überall ein Passwort ausfüllen oder preisgeben. Du kannst das hier jederzeit wieder deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every agent will be able to use any login in your vault without asking you first. A misled agent could fill or reveal a password anywhere. You can turn this off here at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier agente podrá usar cualquier inicio de sesión de tu caja fuerte sin pedírtelo antes. Un agente engañado podría rellenar o revelar una contraseña en cualquier sitio. Puedes desactivar esta opción aquí en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque agent pourra utiliser n'importe quel identifiant de votre coffre sans vous demander au préalable. Un agent trompé pourrait saisir ou révéler un mot de passe n'importe où. Vous pouvez désactiver cette option ici à tout moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのエージェントが、事前の確認なしに保管庫内のあらゆるログイン情報を使用できるようになります。騙されたエージェントが、どこでもパスワードを入力したり漏らしたりするおそれがあります。この設定はいつでもここでオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 에이전트가 먼저 묻지 않고 보관함의 모든 로그인 정보를 사용할 수 있게 돼요. 잘못 유도된 에이전트가 어디에서든 비밀번호를 입력하거나 노출할 수 있어요. 언제든지 여기에서 끌 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke agent kan elke login in je kluis gebruiken zonder het je eerst te vragen. Een misleide agent zou overal een wachtwoord kunnen invullen of onthullen. Je kunt dit hier op elk moment uitschakelen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个智能体都无需事先询问你，即可使用你密码库中的任何登录信息。被误导的智能体可能会在任何地方填入或泄露密码。你可以随时在这里关闭此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個 AI 代理都能在不先詢問你的情況下，使用你密碼庫中的任何登入資訊。遭誤導的 AI 代理可能會在任何地方填入或洩漏密碼。你隨時可以在這裡關閉這項功能。"
          }
        }
      }
    },
    "settings.developer.passwordManager.approvals.enableAllConfirmation.title" : {
      "comment" : "Approvals sheet - all-access confirm title",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenten Zugriff auf alle Passwörter erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow agents to access all passwords?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que los agentes accedan a todas las contraseñas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les agents à accéder à tous les mots de passe ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントにすべてのパスワードへのアクセスを許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 모든 비밀번호에 접근하도록 허용할까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents toegang geven tot alle wachtwoorden?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要允许智能体访问所有密码吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要允許 AI 代理存取所有密碼嗎？"
          }
        }
      }
    },
    "settings.developer.passwordManager.approvals.enableAllDescription" : {
      "comment" : "Approvals sheet - all-access toggle explanation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Agent darf alle gespeicherten Zugangsdaten ohne Nachfrage verwenden. Solange dies aktiviert ist, sind die Freigaben pro Website unten nicht nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Any agent may use any saved login without asking. The per-site grants below are unnecessary while this is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier agente puede usar cualquier inicio de sesión guardado sin pedir permiso. Mientras esta opción esté activada, las aprobaciones por sitio de abajo no son necesarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'importe quel agent peut utiliser n'importe quel identifiant enregistré sans demander. Les autorisations par site ci-dessous sont inutiles tant que cette option est activée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのエージェントも確認なしで、保存されているどのログイン情報でも使用できます。これがオンの間、以下のサイトごとの許可は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 에이전트든 묻지 않고 저장된 모든 로그인 정보를 사용할 수 있어요. 이 설정이 켜져 있는 동안 아래의 사이트별 승인은 필요하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke agent mag zonder te vragen alle opgeslagen inloggegevens gebruiken. De goedkeuringen per site hieronder zijn niet nodig zolang dit aanstaat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何智能体无需询问即可使用任何已保存的登录信息。开启后，下方的按网站授权将不再需要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何 AI 代理都可以不經詢問使用任何已儲存的登入資訊。此選項開啟時，不需要下方的個別網站授權。"
          }
        }
      }
    },
