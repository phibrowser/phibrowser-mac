    "oobe.reauthentication.message" : {
      "comment" : "Auth reauthentication - Alert body explaining required authentication",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir müssen deine Sitzung erneuern, damit die Kontofunktionen weiter funktionieren. Bitte melde dich erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We need to refresh your session before account features can keep working. Please sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos renovar tu sesión para que las funciones de la cuenta sigan funcionando. Inicia sesión de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous devons actualiser votre session pour que les fonctionnalités liées au compte continuent de fonctionner. Veuillez vous reconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント機能を引き続き利用するには、セッションを更新する必要があります。もう一度ログインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 기능을 계속 사용하려면 세션을 갱신해야 해요. 다시 로그인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We moeten je sessie vernieuwen voordat de accountfuncties kunnen blijven werken. Log opnieuw in."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们需要刷新你的会话，账号功能才能继续正常使用。请重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們需要先更新你的工作階段，帳號功能才能繼續運作。請重新登入。"
          }
        }
      }
    },
