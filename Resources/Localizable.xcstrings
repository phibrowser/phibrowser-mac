    "oobe.guestMigration.recovery.loginMessage" : {
      "comment" : "Guest migration recovery - Guidance shown when the original target account must sign in again",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
