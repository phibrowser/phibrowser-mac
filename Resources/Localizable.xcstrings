    "agentControl.connectionApproval.message": {
      "comment": "CDP consent - body",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "An agent is asking to drive Phi Browser over the DevTools Protocol — opening pages, reading content, and acting on your behalf. Only allow agents you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有智能体请求通过 DevTools 协议控制 Phi Browser：打开页面、读取内容，并以你的身份执行操作。请只允许你信任的智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 AI 代理要求透過 DevTools Protocol 操控 Phi Browser，包括開啟頁面、讀取內容，以及代替你執行操作。請只允許你信任的 AI 代理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがDevTools Protocol経由でPhi Browserの操作を求めています。ページを開いたり、内容を読み取ったり、あなたの代わりに操作したりできるようになります。信頼できるエージェントのみを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 DevTools 프로토콜을 통해 Phi Browser를 조작하겠다고 요청하고 있어요. 페이지를 열고, 내용을 읽고, 사용자를 대신해 작업할 수 있어요. 신뢰할 수 있는 에이전트만 허용해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent demande à piloter Phi Browser via le protocole DevTools : ouvrir des pages, lire leur contenu et agir en votre nom. N'autorisez que les agents auxquels vous faites confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent möchte Phi Browser über das DevTools-Protokoll steuern: Seiten öffnen, Inhalte lesen und in deinem Namen handeln. Erlaube das nur Agenten, denen du vertraust."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een agent vraagt om Phi Browser via het DevTools-protocol te besturen: pagina’s openen, inhoud lezen en namens jou handelen. Sta alleen agents toe die je vertrouwt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente solicita controlar Phi Browser mediante el protocolo DevTools: abrir páginas, leer contenido y actuar en tu nombre. Permite solo agentes de tu confianza."
          }
        }
      }
    },
