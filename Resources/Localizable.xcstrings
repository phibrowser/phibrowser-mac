    "settings.phiLink.customBot.guide.suffixText": {
      "comment": "Phi Link - Custom bot guide suffix",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " Telegram bot creation and customization process, follow the on-screen instructions and paste the Bot Token below"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " Telegram 机器人的创建与自定义流程，请按照屏幕上的说明操作，并将机器人令牌粘贴到下方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " Telegram 機器人的建立與自訂流程，請依照畫面上的指示操作，並將 Bot Token 貼到下方"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " Telegramボットの作成とカスタマイズの手順に従って、画面の指示どおりにボットトークンを下に貼り付けてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " Telegram 봇 생성 및 설정 과정을 진행하고, 화면의 안내에 따라 아래에 봇 토큰을 붙여넣으세요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " de création et de personnalisation du bot Telegram, suivez les instructions à l'écran et collez le jeton du bot ci-dessous"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und den Erstellungs- und Anpassungsprozess für deinen Telegram-Bot zu durchlaufen. Folge den Anweisungen auf dem Bildschirm und füge das Bot-Token unten ein"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Telegram-bot maken en aanpassen: volg de instructies op het scherm en plak het bottoken hieronder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " el proceso de creación y personalización del bot de Telegram; sigue las instrucciones en pantalla y pega el Token del bot abajo"
          }
        }
      }
    },
