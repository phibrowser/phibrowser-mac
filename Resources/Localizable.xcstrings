    "accountDeletion.networkError": {
      "comment": "Account deletion - Error when the network request could not complete",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Couldn't reach the deletion service. Check your internet connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接删除服务。请检查你的网络连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到刪除服務。請檢查網路連線後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除サービスに接続できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 서비스에 연결할 수 없어요. 인터넷 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le service de suppression. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Löschdienst konnte nicht erreicht werden. Überprüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de verwijderservice niet bereiken. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servicio de eliminación. Revisa tu conexión a internet y vuelve a intentarlo."
          }
        }
      }
    },
    "accountDeletion.serviceUnavailableError": {
      "comment": "Account deletion - Error when the deletion service reports a server error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The deletion service is temporarily unavailable. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除服务暂时不可用。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除服務暫時無法使用，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除サービスが一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 서비스를 일시적으로 사용할 수 없어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de suppression est temporairement indisponible. Veuillez réessayer plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Löschdienst ist vorübergehend nicht verfügbar. Bitte versuche es später erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verwijderservice is tijdelijk niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de eliminación no está disponible temporalmente. Inténtalo de nuevo más tarde."
          }
        }
      }
    },
    "accountDeletion.sessionExpiredError": {
      "comment": "Account deletion - Error when the access token stays rejected even after renewing it",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your session has expired. Please sign in again, then restart the deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的会话已过期。请重新登录，然后重新开始删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作階段已過期。請重新登入，然後重新開始刪除流程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。もう一度ログインしてから、削除をやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료됐어요. 다시 로그인한 뒤 삭제를 다시 시작해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Veuillez vous reconnecter, puis relancer la suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Bitte melde dich erneut an und starte die Löschung dann neu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sessie is verlopen. Log opnieuw in en start de verwijdering daarna opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión caducó. Inicia sesión de nuevo y reinicia la eliminación."
          }
        }
      }
    },
    "accountDeletion.submission.alreadyInProgressMessage": {
      "comment": "Account deletion - Text shown when a previous deletion request is already running server-side; the finalize confirmation comes next, as after a submission",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A deletion request for this account is already being processed. You will receive an email receipt once the deletion is complete.\n\nPhi will now sign you out, remove its data from this Mac, and quit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号的删除请求已在处理中。删除完成后，你会收到一封确认邮件。\n\nPhi 现在会将你退出登录，移除它在这台 Mac 上的数据，然后退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號的刪除要求已在處理中。刪除完成後，你會收到一封確認電子郵件。\n\nPhi 現在會將你登出、移除它在這部 Mac 上的資料，然後結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの削除リクエストはすでに処理中です。削除が完了すると、確認メールが届きます。\n\nPhiはこれからログアウトし、このMacからPhiのデータを削除して終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 삭제 요청이 이미 처리되고 있어요. 삭제가 완료되면 확인 이메일을 받게 돼요.\n\n이제 Phi에서 로그아웃되고, 이 Mac에서 Phi 데이터가 제거된 후 앱이 종료돼요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande de suppression de ce compte est déjà en cours de traitement. Vous recevrez un accusé de réception par e-mail une fois la suppression terminée.\n\nPhi va maintenant vous déconnecter, supprimer ses données de ce Mac, puis quitter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Löschantrag für dieses Konto wird bereits bearbeitet. Du erhältst eine Bestätigung per E-Mail, sobald die Löschung abgeschlossen ist.\n\nPhi meldet dich jetzt ab, entfernt seine Daten von diesem Mac und wird beendet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt al een verwijderingsverzoek voor dit account verwerkt. Je ontvangt per e-mail een bevestiging zodra de verwijdering is voltooid.\n\nPhi logt je nu uit, verwijdert zijn gegevens van deze Mac en stopt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se está procesando una solicitud de eliminación para esta cuenta. Recibirás un comprobante por correo electrónico cuando se complete la eliminación.\n\nPhi cerrará tu sesión, eliminará sus datos de este Mac y se cerrará."
          }
        }
      }
    },
    "accountDeletion.submission.successMessage": {
      "comment": "Account deletion - Text shown once the deletion request is queued server-side; the deletion itself has not finished yet, and the finalize confirmation comes next",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your deletion request has been submitted. You will receive an email receipt once the deletion is complete.\n\nPhi will now sign you out, remove its data from this Mac, and quit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的删除请求已提交。删除完成后，你会收到一封确认邮件。\n\nPhi 现在会将你退出登录，移除它在这台 Mac 上的数据，然后退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的刪除要求已送出。刪除完成後，你會收到一封確認電子郵件。\n\nPhi 現在會將你登出、移除它在這部 Mac 上的資料，然後結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除リクエストを送信しました。削除が完了すると、確認のメールが届きます。\n\nこれからPhiはログアウトし、このMacからデータを削除して終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 요청이 접수됐어요. 삭제가 완료되면 이메일로 처리 내역을 받게 돼요.\n\n이제 Phi가 로그아웃하고 이 Mac에서 데이터를 삭제한 뒤 종료돼요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre demande de suppression a été envoyée. Vous recevrez un accusé de réception par e-mail une fois la suppression terminée.\n\nPhi va maintenant vous déconnecter, supprimer ses données de ce Mac et se fermer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Löschanfrage wurde übermittelt. Du erhältst eine E-Mail-Bestätigung, sobald die Löschung abgeschlossen ist.\n\nPhi meldet dich jetzt ab, entfernt seine Daten von diesem Mac und beendet sich."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verwijderingsverzoek is ingediend. Je ontvangt per e-mail een bevestiging zodra de verwijdering is voltooid.\n\nPhi logt je nu uit, verwijdert zijn gegevens van deze Mac en stopt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió tu solicitud de eliminación. Recibirás un comprobante por correo electrónico cuando se complete la eliminación.\n\nAhora Phi cerrará tu sesión, eliminará sus datos de este Mac y se cerrará."
          }
        }
      }
    },
    "accountDeletion.verification.codeField.accessibilityLabel": {
