    "spaces.importProgress.changeProfileBlocked.message": {
      "comment": "Body shown when a Space action is blocked by an in-progress import",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "An import is still adding bookmarks to this Space. Wait for it to finish, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入操作仍在向此空间添加书签。请等待其完成后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入作業仍在將書籤加入此空間。請等它完成後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートがまだこのスペースにブックマークを追加しています。完了を待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기가 아직 이 스페이스에 북마크를 추가하고 있어요. 완료될 때까지 기다렸다가 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une importation ajoute encore des favoris à cet Espace. Attendez qu'elle se termine, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Import fügt diesem Space noch Lesezeichen hinzu. Warte, bis er abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden door een import nog bladwijzers aan deze Space toegevoegd. Wacht tot de import klaar is en probeer het opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una importación aún está agregando marcadores a este Espacio. Espera a que termine y vuelve a intentarlo."
          }
        }
      }
    },
    "spaces.importProgress.changeProfileBlocked.title": {
      "comment": "Title shown when changing a Space's profile is blocked by an in-progress import",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Can’t change this Space’s profile yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法更改此空间的个人资料"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚無法變更此空間的設定檔"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスペースのプロファイルはまだ変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이 스페이스의 프로필을 변경할 수 없어요"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer le profil de cet Espace pour le moment"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil dieses Space kann noch nicht geändert werden"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel van deze Space kan nog niet worden gewijzigd"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se puede cambiar el perfil de este Espacio"
          }
        }
      }
    },
