    "settings.spaces.pinnedTabScope.profileDescription": {
      "comment": "Spaces settings - description of Profile pinned-tab scope",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Spaces using the same profile share pinned tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一个人资料的空间共享固定标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一個設定檔的空間會共用釘選分頁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じプロファイルを使用するスペース間で固定タブが共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 프로필을 사용하는 스페이스는 고정된 탭을 공유해요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Espaces qui utilisent le même profil partagent leurs onglets épinglés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces mit demselben Profil teilen sich angeheftete Tabs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces met hetzelfde profiel delen vastgezette tabbladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Espacios que usan el mismo perfil comparten las pestañas fijadas."
          }
        }
      }
    },
