    "app.userDataImport.confirmation.message": {
      "comment": "User data import - Confirmation alert body warning data replacement and relaunch",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This replaces the Phi user data folder with the archive and restarts Phi. Save your work first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会用归档替换 Phi 用户数据文件夹，并重启 Phi。请先保存你的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會以封存檔取代 Phi 的使用者資料，並重新啟動 Phi。請先儲存你的工作內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiのユーザーデータフォルダをアーカイブの内容で置き換えて、Phiを再起動します。先に作業内容を保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 사용자 데이터 폴더를 아카이브로 교체하고 Phi를 다시 시작해요. 먼저 작업 내용을 저장해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération remplace le dossier de données utilisateur de Phi par l'archive, puis redémarre Phi. Enregistrez d'abord votre travail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Ordner mit den Phi-Benutzerdaten durch das Archiv ersetzt und Phi neu gestartet. Speichere vorher deine Arbeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de map met Phi-gebruikersgegevens vervangen door het archief en start Phi opnieuw. Bewaar eerst je werk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplaza la carpeta de datos de usuario de Phi por el archivo y reinicia Phi. Guarda tu trabajo antes."
          }
        }
      }
    },
