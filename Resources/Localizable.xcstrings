    "common.credentialApproval.allAgentsDescription": {
      "comment": "Credential approval - all-agents row explanation",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Any agent may use this approval, not just “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何智能体都可以使用此授权，而不仅限于「%@」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何 AI 代理都可以使用此核准，而不僅限於「%@」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この承認は「%@」に限らず、どのエージェントでも使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”뿐만 아니라 모든 에이전트가 이 승인을 사용할 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quel agent peut utiliser cette approbation, pas seulement « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent darf diese Freigabe verwenden, nicht nur „%@“."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke agent mag deze goedkeuring gebruiken, niet alleen “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier agente puede usar esta aprobación, no solo “%@”."
          }
        }
      }
    },
