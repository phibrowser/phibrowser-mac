    "settings.developer.passwordManager.approvals.tooltip" : {
      "comment" : "Phi & AI settings - tooltip for the approvals row",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe und widerrufe, welche Agenten deine gespeicherten Zugangsdaten ohne Nachfrage verwenden dürfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Review and revoke which agents may use your saved logins without asking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa y revoca qué agentes pueden usar tus inicios de sesión guardados sin pedir permiso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez et révoquez les agents autorisés à utiliser vos identifiants enregistrés sans demander confirmation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのログイン情報を確認なしで使用できるエージェントを確認し、取り消せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 에이전트가 묻지 않고 저장된 로그인 정보를 사용할 수 있는지 확인하고 철회해요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk welke agents je opgeslagen inloggegevens zonder vragen mogen gebruiken en trek goedkeuringen in"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看并撤销哪些智能体可以无需询问就使用你保存的登录信息"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看並撤銷哪些 AI 代理可以不經詢問就使用你儲存的登入資訊"
          }
        }
      }
    },
