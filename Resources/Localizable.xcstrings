    "settings.developer.agentProfileAccess.description" : {
      "comment" : "Developer settings - Explanation for the per-profile agent-Space allowlist",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, in welchen Profilen Agenten eigene Spaces erstellen dürfen. Wird ein Profil deaktiviert, können Agenten keine neuen daran gebundenen Spaces mehr öffnen; bestehende Spaces bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose which profiles agents may create their own Spaces in. Turning a profile off stops agents from opening any new Space bound to it; existing Spaces are unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige en qué perfiles pueden crear los agentes sus propios Espacios. Desactivar un perfil impide que los agentes abran cualquier Espacio nuevo vinculado a él; los Espacios existentes no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les profils dans lesquels les agents peuvent créer leurs propres Espaces. Désactiver un profil empêche les agents d'ouvrir tout nouvel Espace qui y est associé ; les Espaces existants ne sont pas affectés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが自身のスペースを作成できるプロファイルを選択してください。プロファイルをオフにすると、そのプロファイルに紐づく新しいスペースをエージェントは開けなくなります。既存のスペースには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 자신의 스페이스를 만들 수 있는 프로필을 선택해 주세요. 프로필을 끄면 해당 프로필에 연결된 새 스페이스를 에이전트가 열 수 없게 돼요. 기존 스페이스는 영향을 받지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies in welke profielen agents hun eigen Spaces mogen aanmaken. Als je een profiel uitschakelt, kunnen agents geen nieuwe Space meer openen die aan dat profiel is gekoppeld; bestaande Spaces blijven ongewijzigd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择智能体可以在哪些个人资料中创建自己的空间。关闭某个个人资料后，智能体将无法打开任何绑定到该个人资料的新空间；现有空间不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
