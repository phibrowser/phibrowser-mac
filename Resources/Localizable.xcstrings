            "state": "translated",
            "value": "La limpieza de los datos de invitado está incompleta"
          }
        }
      }
    },
    "oobe.guestMigration.failure.message": {
      "comment": "Guest migration - Alert message explaining that Guest data remains safe and migration can be retried",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Phi couldn’t move your Guest data. Your data is safe, and you can try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 未能迁移你的访客数据。你的数据很安全，可以再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi 無法搬移你的訪客資料。你的資料很安全，你可以再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiはゲストデータを移行できませんでした。データは安全に保たれているので、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi가 게스트 데이터를 이동하지 못했어요. 데이터는 안전하며 다시 시도할 수 있어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi n'a pas pu transférer vos données du mode Invité. Vos données sont en sécurité et vous pouvez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi konnte deine Gastdaten nicht verschieben. Deine Daten sind sicher, und du kannst es erneut versuchen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi kon je gastgegevens niet verplaatsen. Je gegevens zijn veilig en je kunt het opnieuw proberen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi no pudo mover tus datos de invitado. Tus datos están a salvo y puedes volver a intentarlo."
          }
        }
      }
    },
