    "settings.developer.agentBrowsingDataAccess.description": {
      "comment": "Developer settings - Explanation for the agent user-space operations toggle",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lets agent tooling manage your own browsing data — Spaces, profiles, URL rules, pinned tabs, bookmarks, and the tab layout of your windows. When off, agents can only work inside their own agent Spaces. Applies immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许智能体工具管理你自己的浏览数据，包括空间、配置文件、网址规则、固定标签页、书签，以及各窗口的标签页布局。关闭后，智能体只能在它们自己的智能体空间内操作。立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 AI 代理工具管理你自己的瀏覽資料，包括空間、設定檔、網址規則、釘選分頁、書籤，以及視窗的分頁版面配置。關閉時，AI 代理只能在自己的 AI 代理空間中作業。立即生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントツールが、スペース、プロファイル、URLルール、固定タブ、ブックマーク、ウインドウのタブレイアウトといった、あなた自身のブラウジングデータを管理できるようにします。オフにすると、エージェントは自分のエージェントスペース内でのみ操作できます。設定はすぐに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 도구가 스페이스, 프로필, URL 규칙, 고정 탭, 북마크, 윈도우의 탭 레이아웃 등 사용자의 브라우징 데이터를 관리할 수 있게 해요. 끄면 에이전트는 자신의 에이전트 스페이스 안에서만 작업할 수 있어요. 즉시 적용돼요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux outils d'agents de gérer vos propres données de navigation : Espaces, profils, règles d'URL, onglets épinglés, favoris et disposition des onglets de vos fenêtres. Lorsque cette option est désactivée, les agents ne peuvent travailler que dans leurs propres Espaces d'agent. S'applique immédiatement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Agent-Tools, deine eigenen Browserdaten zu verwalten: Spaces, Profile, URL-Regeln, angeheftete Tabs, Lesezeichen und das Tab-Layout deiner Fenster. Wenn deaktiviert, können Agenten nur in ihren eigenen Agent-Spaces arbeiten. Wird sofort wirksam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat agent-tooling je eigen browsegegevens beheren: Spaces, profielen, URL-regels, vastgezette tabbladen, bladwijzers en de tabbladindeling van je vensters. Als dit uitstaat, kunnen agents alleen in hun eigen agent-Spaces werken. Wordt direct toegepast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las herramientas de agentes gestionen tus propios datos de navegación: Espacios, perfiles, reglas de URL, pestañas fijadas, marcadores y la disposición de las pestañas de tus ventanas. Cuando está desactivado, los agentes solo pueden trabajar dentro de sus propios Espacios de agente. Se aplica de inmediato."
          }
        }
      }
    },
    "settings.developer.agentBrowsingDataAccess.enableToggle": {
      "comment": "Developer settings - Toggle title for agent user-space operations",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Allow agents to operate your Spaces"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许智能体操作你的空间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 AI 代理操作你的空間"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントにスペースの操作を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 내 스페이스를 조작하도록 허용"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les agents à utiliser vos Espaces"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten dürfen deine Spaces bedienen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents toestaan je Spaces te bedienen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que los agentes operen tus Espacios"
          }
        }
      }
    },
    "settings.developer.agentControl.allowedAgents.description": {
      "comment": "Developer settings - Explanation for the allowed CDP agent list",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Processes you’ve approved to control Phi. Removing one makes it ask again next time it connects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已批准可以控制 Phi 的进程。移除后，下次连接时会重新询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已核准可控制 Phi 的程序。移除某個程序後，它下次連線時會再次要求核准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiの操作を承認したプロセスです。削除すると、次に接続したときに再び確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi를 제어하도록 승인한 프로세스예요. 승인을 삭제하면 다음에 연결될 때 다시 요청해요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processus que vous avez autorisés à contrôler Phi. Si vous en supprimez un, il redemandera l'autorisation à sa prochaine connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozesse, denen du die Steuerung von Phi erlaubt hast. Wenn du einen entfernst, fragt er beim nächsten Verbinden erneut nach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Processen die je hebt goedgekeurd om Phi te besturen. Als je er een verwijdert, wordt er bij de volgende verbinding opnieuw om goedkeuring gevraagd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesos que has aprobado para controlar Phi. Si eliminas uno, volverá a pedir permiso la próxima vez que se conecte."
          }
        }
      }
    },
    "settings.developer.agentControl.allowedAgents.emptyMessage": {
      "comment": "Developer settings - Empty state for the allowed CDP agent list",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No agents approved yet. The first time one connects, Phi asks for your approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未批准任何智能体。当有智能体首次连接时，Phi 会请求你的批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未核准任何 AI 代理。第一次有 AI 代理連線時，Phi 會徵求你的核准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済みのエージェントはまだありません。エージェントが初めて接続したときに、Phiが承認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 승인된 에이전트가 없어요. 처음 연결될 때 Phi가 승인을 요청해요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun agent approuvé pour l'instant. À la première connexion d'un agent, Phi vous demandera votre approbation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Agenten freigegeben. Wenn sich zum ersten Mal einer verbindet, fragt Phi dich um Erlaubnis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen agents goedgekeurd. De eerste keer dat er een agent verbinding maakt, vraagt Phi om je goedkeuring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has aprobado ningún agente. La primera vez que uno se conecte, Phi te pedirá aprobación."
          }
        }
      }
    },
